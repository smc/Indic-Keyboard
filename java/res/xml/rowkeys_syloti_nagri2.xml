<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꠀ SYLOTI NAGRI LETTER A -->
            <Key
                latin:keySpec="&#xA800;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠗ SYLOTI NAGRI LETTER DHO -->
            <Key
                latin:keySpec="&#xA817;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠊ SYLOTI NAGRI LETTER GHO -->
            <Key
                latin:keySpec="&#xA80A;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠏ SYLOTI NAGRI LETTER JHO -->
            <Key
                latin:keySpec="&#xA80F;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠈ SYLOTI NAGRI LETTER KHO -->
            <Key
                latin:keySpec="&#xA808;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

        </case>
        <default>
            <!-- ꠣ SYLOTI NAGRI VOWEL SIGN A -->
            <Key
                latin:keySpec="&#x25CC;&#xA823;|&#xA823;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠡ SYLOTI NAGRI LETTER SO -->
            <Key
                latin:keySpec="&#xA821;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠖ SYLOTI NAGRI LETTER DO -->
            <Key
                latin:keySpec="&#xA816;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠉ SYLOTI NAGRI LETTER GO -->
            <Key
                latin:keySpec="&#xA809;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠢ SYLOTI NAGRI LETTER HO -->
            <Key
                latin:keySpec="&#xA822;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠎ SYLOTI NAGRI LETTER JO -->
            <Key
                latin:keySpec="&#xA80E;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠇ SYLOTI NAGRI LETTER KO -->
            <Key
                latin:keySpec="&#xA807;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠟ SYLOTI NAGRI LETTER LO -->
            <Key
                latin:keySpec="&#xA81F;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Z ଁ ORIYA SIGN CANDRABINDU-->
            <Key
                latin:keySpec="&#x0B01;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--X କ୍ଷ ORIYA LETTER KA ORIYA SIGN VIRAMA ORIYA LETTER SSA-->
            <Key
                latin:keySpec="&#x0B15;&#x0B4D;&#x0B37;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--C ଛ ORIYA LETTER CHA-->
            <Key
                latin:keySpec="&#x0B1B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--V ଵ ORIYA LETTER VA-->
            <Key
                latin:keySpec="&#x0B35;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--B ଭ ORIYA LETTER BHA-->
            <Key
                latin:keySpec="&#x0B2D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--N ଣ ORIYA LETTER NNA-->
            <Key
                latin:keySpec="&#x0B23;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--M ଂ ORIYA SIGN ANUSVARA-->
            <Key
                latin:keySpec="&#x0B02;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--? ଐ ORIYA LETTER AI-->
            <Key
                latin:keySpec="&#x0B10;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--z ଙ ORIYA LETTER NGA-->
            <Key
                latin:keySpec="&#x0B19;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--x ଷ ORIYA LETTER SSA-->
            <Key
                latin:keySpec="&#x0B37;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--c ଚ ORIYA LETTER CA-->
            <Key
                latin:keySpec="&#x0B1A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--v ୱ ORIYA LETTER WA-->
            <Key
                latin:keySpec="&#x0B71;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--b ବ ORIYA LETTER BA-->
            <Key
                latin:keySpec="&#x0B2C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--n ନ ORIYA LETTER NA-->
            <Key
                latin:keySpec="&#x0B28;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--m ମ ORIYA LETTER MA-->
            <Key
                latin:keySpec="&#x0B2E;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--/ ଏ ORIYA LETTER E-->
            <Key
                latin:keySpec="&#x0B0F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

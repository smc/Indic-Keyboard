<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--A ਓ GURMUKHI LETTER OO-->
            <Key
                latin:keySpec="&#x0A13;"
                latin:keyLabelFlags="fontNormal" />

            <!--S ਏ GURMUKHI LETTER EE-->
            <Key
                latin:keySpec="&#x0A0F;"
                latin:keyLabelFlags="fontNormal" />

            <!--D ਅ GURMUKHI LETTER A-->
            <Key
                latin:keySpec="&#x0A05;"
                latin:moreKeys="&#x0A73;,&#x0A72;"
                latin:keyHintLabel="&#x0A73;"
                latin:keyLabelFlags="fontNormal" />

            <!--F ਇ GURMUKHI LETTER I-->
            <Key
                latin:keySpec="&#x0A07;"
                latin:keyLabelFlags="fontNormal" />

            <!--G ਉ GURMUKHI LETTER U-->
            <Key
                latin:keySpec="&#x0A09;"
                latin:keyLabelFlags="fontNormal" />

            <!--H ਠ GURMUKHI LETTER TTHA-->
            <Key
                latin:keySpec="&#x0A20;"
                latin:keyLabelFlags="fontNormal" />

            <!--J ਝ GURMUKHI LETTER JHA-->
            <Key
                latin:keySpec="&#x0A1D;"
                latin:moreKeys="&#x0A1E;"
                latin:keyHintLabel="&#x0A1E;"
                latin:keyLabelFlags="fontNormal" />

            <!--K ਖ GURMUKHI LETTER KHA-->
            <Key
                latin:keySpec="&#x0A16;"
                latin:moreKeys="&#x0A59;"
                latin:keyHintLabel="&#x0A59;"
                latin:keyLabelFlags="fontNormal" />

            <!--L ਥ GURMUKHI LETTER THA-->
            <Key
                latin:keySpec="&#x0A25;"
                latin:keyLabelFlags="fontNormal" />

            <!--; ਸ਼ GURMUKHI LETTER SHA-->
            <Key
                latin:keySpec="&#x0A36;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--a ੋ GURMUKHI VOWEL SIGN OO-->
            <Key
                latin:keySpec="&#x0A4B;"
                latin:keyLabelFlags="fontNormal" />

            <!--s ੇ GURMUKHI VOWEL SIGN EE-->
            <Key
                latin:keySpec="&#x0A47;"
                latin:keyLabelFlags="fontNormal" />

            <!--d ੍ GURMUKHI SIGN VIRAMA-->
            <Key
                latin:keySpec="&#x0A4D;"
                latin:keyLabelFlags="fontNormal" />

            <!--f ਿ GURMUKHI VOWEL SIGN I-->
            <Key
                latin:keySpec="&#x0A3F;"
                latin:keyLabelFlags="fontNormal" />

            <!--g ੁ GURMUKHI VOWEL SIGN U-->
            <Key
                latin:keySpec="&#x0A41;"
                latin:keyLabelFlags="fontNormal" />

            <!--h ਹ GURMUKHI LETTER HA-->
            <Key
                latin:keySpec="&#x0A39;"
                latin:moreKeys="&#x0A4D;&#x0A39;"
                latin:keyHintLabel="&#x0A4D;&#x0A39;"
                latin:keyLabelFlags="fontNormal" />

            <!--j ਜ GURMUKHI LETTER JA-->
            <Key
                latin:keySpec="&#x0A1C;"
                latin:moreKeys="&#x0A5B;"
                latin:keyHintLabel="&#x0A5B;"
                latin:keyLabelFlags="fontNormal" />

            <!--k ਕ GURMUKHI LETTER KA-->
            <Key
                latin:keySpec="&#x0A15;"
                latin:keyLabelFlags="fontNormal" />

            <!--l ਲ GURMUKHI LETTER LA-->
            <Key
                latin:keySpec="&#x0A32;"
                latin:moreKeys="&#x0A33;"
                latin:keyHintLabel="&#x0A33;"
                latin:keyLabelFlags="fontNormal" />

            <!--; ਸ GURMUKHI LETTER SA-->
            <Key
                latin:keySpec="&#x0A38;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

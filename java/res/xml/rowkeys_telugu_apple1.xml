<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--క్ష్మి TELUGU LETTER KA/TELUGU SIGN VIRAMA/TELUGU LETTER SSA/TELUGU SIGN VIRAMA/TELUGU LETTER MA/TELUGU VOWEL SIGN I-->
            <Key
                latin:keySpec="&#x0C15;&#x0C4D;&#x0C37;&#x0C4D;&#x0C2E;&#x0C3F;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఋ TELUGU LETTER VOCALIC R-->
            <Key
                latin:keySpec="&#x0C0B;"
                latin:keyLabelFlags="fontNormal" />

            <!--ౠ TELUGU LETTER VOCALIC RR-->
            <Key
                latin:keySpec="&#x0C60;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఙ TELUGU LETTER NGA-->
            <Key
                latin:keySpec="&#x0C19;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఞ TELUGU LETTER NYA-->
            <Key
                latin:keySpec="&#x0C1E;"
                latin:keyLabelFlags="fontNormal" />

            <!--క్ష TELUGU LETTER KA/TELUGU SIGN VIRAMA/TELUGU LETTER SSA-->
            <Key
                latin:keySpec="&#x0C15;&#x0C4D;&#x0C37;"
                latin:keyLabelFlags="fontNormal" />

            <!--శ్రీ TELUGU LETTER SHA/TELUGU SIGN VIRAMA/TELUGU LETTER RA/TELUGU VOWEL SIGN II-->
            <Key
                latin:keySpec="&#x0C36;&#x0C4D;&#x0C30;&#x0C40;"
                latin:keyLabelFlags="fontNormal" />

            <!--/ SOLIDUS-->
            <Key
                latin:keySpec="&#x002F;"
                latin:keyLabelFlags="fontNormal" />

            <!--స్త్ర TELUGU LETTER SA/TELUGU SIGN VIRAMA/TELUGU LETTER TA/TELUGU SIGN VIRAMA/TELUGU LETTER RA-->
            <Key
                latin:keySpec="&#x0C38;&#x0C4D;&#x0C24;&#x0C4D;&#x0C30;"
                latin:keyLabelFlags="fontNormal" />

            <!--ష్ట్ర TELUGU LETTER SSA/TELUGU SIGN VIRAMA/TELUGU LETTER TTA/TELUGU SIGN VIRAMA/TELUGU LETTER RA-->
            <Key
                latin:keySpec="&#x0C37;&#x0C4D;&#x0C1F;&#x0C4D;&#x0C30;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--అ TELUGU LETTER A-->
            <Key
                latin:keySpec="&#x0C05;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఈ TELUGU LETTER II-->
            <Key
                latin:keySpec="&#x0C08;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఆ TELUGU LETTER AA-->
            <Key
                latin:keySpec="&#x0C06;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఇ TELUGU LETTER I-->
            <Key
                latin:keySpec="&#x0C07;"
                latin:moreKeys="&#x0C61;"
                latin:keyHintLabel="&#x0C61;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఒ TELUGU LETTER O-->
            <Key
                latin:keySpec="&#x0C12;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఓ TELUGU LETTER OO-->
            <Key
                latin:keySpec="&#x0C13;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఎ TELUGU LETTER E-->
            <Key
                latin:keySpec="&#x0C0E;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఉ TELUGU LETTER U-->
            <Key
                latin:keySpec="&#x0C09;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఏ TELUGU LETTER EE-->
            <Key
                latin:keySpec="&#x0C0F;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఊ TELUGU LETTER UU-->
            <Key
                latin:keySpec="&#x0C0A;"
                latin:moreKeys="&#x0C59;"
                latin:keyHintLabel="&#x0C59;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- 𑢡 WARANG CITI CAPITAL LETTER A -->
            <Key
                latin:keySpec="&#x118A1;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢾 WARANG CITI CAPITAL LETTER SII -->
            <Key
                latin:keySpec="&#x118BE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢱 WARANG CITI CAPITAL LETTER ODD -->
            <Key
                latin:keySpec="&#x118B1;"
                latin:moreKeys="&#x118B4;"
                latin:keyHintLabel="&#x118B4;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/zwj_key|&#x200D;" />

            <!-- 𑢫 WARANG CITI CAPITAL LETTER GA -->
            <Key
                latin:keySpec="&#x118AB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢹 WARANG CITI CAPITAL LETTER HIYO -->
            <Key
                latin:keySpec="&#x118B9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢮 WARANG CITI CAPITAL LETTER YUJ -->
            <Key
                latin:keySpec="&#x118AE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢬 WARANG CITI CAPITAL LETTER KO -->
            <Key
                latin:keySpec="&#x118AC;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢺 WARANG CITI CAPITAL LETTER HOLO -->
            <Key
                latin:keySpec="&#x118BA;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- 𑣁 WARANG CITI SMALL LETTER A -->
            <Key
                latin:keySpec="&#x118C1;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣞 WARANG CITI SMALL LETTER SII -->
            <Key
                latin:keySpec="&#x118DE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣑 WARANG CITI SMALL LETTER ODD -->
            <Key
                latin:keySpec="&#x118D1;"
                latin:moreKeys="&#x118D4;"
                latin:keyHintLabel="&#x118D4;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/zwj_key|&#x200D;" />

            <!-- 𑣋 WARANG CITI SMALL LETTER GA -->
            <Key
                latin:keySpec="&#x118CB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣙 WARANG CITI SMALL LETTER HIYO -->
            <Key
                latin:keySpec="&#x118D9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣎 WARANG CITI SMALL LETTER YUJ -->
            <Key
                latin:keySpec="&#x118CE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣌 WARANG CITI SMALL LETTER KO -->
            <Key
                latin:keySpec="&#x118CC;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣚 WARANG CITI SMALL LETTER HOLO -->
            <Key
                latin:keySpec="&#x118DA;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

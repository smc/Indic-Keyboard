<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꢀ SAURASHTRA SIGN ANUSVARA -->
            <Key
                latin:keySpec="&#x25CC;&#xA880;|&#xA880;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꣅ SAURASHTRA SIGN CANDRABINDU -->
            <Key
                latin:keySpec="&#x25CC;&#xA8C5;|&#xA8C5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢘ SAURASHTRA LETTER CHA -->
            <Key
                latin:keySpec="&#xA898;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢟ SAURASHTRA LETTER DDHA -->
            <Key
                latin:keySpec="&#xA89F;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢩ SAURASHTRA LETTER BHA -->
            <Key
                latin:keySpec="&#xA8A9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢠ SAURASHTRA LETTER NNA -->
            <Key
                latin:keySpec="&#xA8A0;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢖ SAURASHTRA LETTER NGA -->
            <Key
                latin:keySpec="&#xA896;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- ꢯ SAURASHTRA LETTER SHA -->
            <Key
                latin:keySpec="&#xA8AF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꣄ SAURASHTRA SIGN VIRAMA -->
            <Key
                latin:keySpec="&#x25CC;&#xA8C4;|&#xA8C4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢗ SAURASHTRA LETTER CA -->
            <Key
                latin:keySpec="&#xA897;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢞ SAURASHTRA LETTER DDA -->
            <Key
                latin:keySpec="&#xA89E;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢨ SAURASHTRA LETTER BA -->
            <Key
                latin:keySpec="&#xA8A8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢥ SAURASHTRA LETTER NA -->
            <Key
                latin:keySpec="&#xA8A5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢪ SAURASHTRA LETTER MA -->
            <Key
                latin:keySpec="&#xA8AA;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

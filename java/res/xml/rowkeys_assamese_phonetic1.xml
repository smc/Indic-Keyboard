<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Q ধ BENGALI LETTER DHA-->
            <Key
                latin:keySpec="&#x09A7;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--W ঊ BENGALI LETTER UU-->
            <Key
                latin:keySpec="&#x098A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--E ঈ BENGALI LETTER II-->
            <Key
                latin:keySpec="&#x0988;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--R ড় BENGALI LETTER RRA-->
            <Key
                latin:keySpec="&#x09DC;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--T ঠ BENGALI LETTER TTHA-->
            <Key
                latin:keySpec="&#x09A0;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--Y ঐ BENGALI LETTER AI-->
            <Key
                latin:keySpec="&#x0990;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--U উ BENGALI LETTER U-->
            <Key
                latin:keySpec="&#x0989;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--I ই BENGALI LETTER I-->
            <Key
                latin:keySpec="&#x0987;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--O ঔ BENGALI LETTER AU-->
            <Key
                latin:keySpec="&#x0994;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--P ফ BENGALI LETTER PHA-->
            <Key
                latin:keySpec="&#x09AB;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--{ ৈ BENGALI VOWEL SIGN AI-->
            <Key
                latin:keySpec="&#x09C8;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--} ৌ BENGALI VOWEL SIGN AU-->
            <Key
                latin:keySpec="&#x09CC;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--q দ BENGALI LETTER DA-->
            <Key
                latin:keySpec="&#x09A6;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--w ূ BENGALI VOWEL SIGN UU-->
            <Key
                latin:keySpec="&#x09C2;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--e ী BENGALI VOWEL SIGN II-->
            <Key
                latin:keySpec="&#x09C0;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--r ৰ BENGALI LETTER RA WITH MIDDLE DIAGONAL-->
            <Key
                latin:keySpec="&#x09F0;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--t ট BENGALI LETTER TTA-->
            <Key
                latin:keySpec="&#x099F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--y এ BENGALI LETTER E-->
            <Key
                latin:keySpec="&#x098F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--u ু BENGALI VOWEL SIGN U-->
            <Key
                latin:keySpec="&#x09C1;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--i ি BENGALI VOWEL SIGN I-->
            <Key
                latin:keySpec="&#x09BF;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--o ও BENGALI LETTER O-->
            <Key
                latin:keySpec="&#x0993;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--p প BENGALI LETTER PA-->
            <Key
                latin:keySpec="&#x09AA;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--[ ে BENGALI VOWEL SIGN E-->
            <Key
                latin:keySpec="&#x09C7;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--] ো BENGALI VOWEL SIGN O-->
            <Key
                latin:keySpec="&#x09CB;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

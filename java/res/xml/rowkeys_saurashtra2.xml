<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꢃ SAURASHTRA LETTER AA -->
            <Key
                latin:keySpec="&#xA883;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢰ SAURASHTRA LETTER SSA -->
            <Key
                latin:keySpec="&#xA8B0;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢤ SAURASHTRA LETTER DHA -->
            <Key
                latin:keySpec="&#xA8A4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢝ SAURASHTRA LETTER TTHA -->
            <Key
                latin:keySpec="&#xA89D;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢕ SAURASHTRA LETTER GHA -->
            <Key
                latin:keySpec="&#xA895;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢁ SAURASHTRA SIGN VISARGA -->
            <Key
                latin:keySpec="&#x25CC;&#xA881;|&#xA881;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢚ SAURASHTRA LETTER JHA -->
            <Key
                latin:keySpec="&#xA89A;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢓ SAURASHTRA LETTER KHA -->
            <Key
                latin:keySpec="&#xA893;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢳ SAURASHTRA LETTER LLA -->
            <Key
                latin:keySpec="&#xA8B3;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- ꢵ SAURASHTRA VOWEL SIGN AA -->
            <Key
                latin:keySpec="&#x25CC;&#xA8B5;|&#xA8B5;"
                latin:moreKeys="&#xA882;"
                latin:keyHintLabel="&#xA882;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢱ SAURASHTRA LETTER SA -->
            <Key
                latin:keySpec="&#xA8B1;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢣ SAURASHTRA LETTER DA -->
            <Key
                latin:keySpec="&#xA8A3;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢜ SAURASHTRA LETTER TTA -->
            <Key
                latin:keySpec="&#xA89C;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢔ SAURASHTRA LETTER GA -->
            <Key
                latin:keySpec="&#xA894;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢲ SAURASHTRA LETTER HA -->
            <Key
                latin:keySpec="&#xA8B2;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢙ SAURASHTRA LETTER JA -->
            <Key
                latin:keySpec="&#xA899;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢒ SAURASHTRA LETTER KA -->
            <Key
                latin:keySpec="&#xA892;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꢭ SAURASHTRA LETTER LA -->
            <Key
                latin:keySpec="&#xA8AD;"
                latin:moreKeys="&#xA88A;,&#xA88B;,&#x25CC;&#xA8BC;|&#xA8BC;,&#x25CC;&#xA8BD;|&#xA8BD;"
                latin:keyHintLabel="&#xA88A;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

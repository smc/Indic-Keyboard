<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Z ਼ GURMUKHI SIGN NUKTA-->
            <Key
                latin:keySpec="&#x0A3C;"
                latin:keyLabelFlags="fontNormal" />

            <!--X ੰ GURMUKHI TIPPI-->
            <Key
                latin:keySpec="&#x0A70;"
                latin:keyLabelFlags="fontNormal" />

            <!--C ਛ GURMUKHI LETTER CHA-->
            <Key
                latin:keySpec="&#x0A1B;"
                latin:keyLabelFlags="fontNormal" />

            <!--V ਯ GURMUKHI LETTER YA-->
            <Key
                latin:keySpec="&#x0A2F;"
                latin:keyLabelFlags="fontNormal" />

            <!--B ਭ GURMUKHI LETTER BHA-->
            <Key
                latin:keySpec="&#x0A2D;"
                latin:keyLabelFlags="fontNormal" />

            <!--N ਣ GURMUKHI LETTER NNA-->
            <Key
                latin:keySpec="&#x0A23;"
                latin:keyLabelFlags="fontNormal" />

            <!--M ਠ GURMUKHI LETTER TTHA-->
            <Key
                latin:keySpec="&#x0A20;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--z ੱ GURMUKHI ADDAK-->
            <Key
                latin:keySpec="&#x0A71;"
                latin:keyLabelFlags="fontNormal" />

            <!--x ਂ GURMUKHI SIGN BINDI-->
            <Key
                latin:keySpec="&#x0A02;"
                latin:keyLabelFlags="fontNormal" />

            <!--c ਚ GURMUKHI LETTER CA-->
            <Key
                latin:keySpec="&#x0A1A;"
                latin:keyLabelFlags="fontNormal" />

            <!--v ਵ GURMUKHI LETTER VA-->
            <Key
                latin:keySpec="&#x0A35;"
                latin:keyLabelFlags="fontNormal" />

            <!--b ਬ GURMUKHI LETTER BA-->
            <Key
                latin:keySpec="&#x0A2C;"
                latin:keyLabelFlags="fontNormal" />

            <!--n ਨ GURMUKHI LETTER NA-->
            <Key
                latin:keySpec="&#x0A28;"
                latin:keyLabelFlags="fontNormal" />

            <!--m ਮ GURMUKHI LETTER MA-->
            <Key
                latin:keySpec="&#x0A2E;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

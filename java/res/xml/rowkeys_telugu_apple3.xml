<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--ఠ TELUGU LETTER TTHA-->
            <Key
                latin:keySpec="&#x0C20;"
                latin:moreKeys="&#x0C56;"
                latin:keyHintLabel="&#x0C56;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఘ TELUGU LETTER GHA-->
            <Key
                latin:keySpec="&#x0C18;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఢ TELUGU LETTER DDHA-->
            <Key
                latin:keySpec="&#x0C22;"
                latin:keyLabelFlags="fontNormal" />

            <!--భ TELUGU LETTER BHA-->
            <Key
                latin:keySpec="&#x0C2D;"
                latin:keyLabelFlags="fontNormal" />

            <!--హ TELUGU LETTER HA-->
            <Key
                latin:keySpec="&#x0C39;"
                latin:keyLabelFlags="fontNormal" />

            <!--క్ష్మీ TELUGU LETTER KA/TELUGU SIGN VIRAMA/TELUGU LETTER SSA/TELUGU SIGN VIRAMA/TELUGU LETTER MA/TELUGU VOWEL SIGN II-->
            <Key
                latin:keySpec="&#x0C15;&#x0C4D;&#x0C37;&#x0C4D;&#x0C2E;&#x0C40;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఛ TELUGU LETTER CHA-->
            <Key
                latin:keySpec="&#x0C1B;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--ట TELUGU LETTER TTA-->
            <Key
                latin:keySpec="&#x0C1F;"
                latin:moreKeys="&#x0C55;"
                latin:keyHintLabel="&#x0C55;"
                latin:keyLabelFlags="fontNormal" />

            <!--గ TELUGU LETTER GA-->
            <Key
                latin:keySpec="&#x0C17;"
                latin:keyLabelFlags="fontNormal" />

            <!--డ TELUGU LETTER DDA-->
            <Key
                latin:keySpec="&#x0C21;"
                latin:keyLabelFlags="fontNormal" />

            <!--బ TELUGU LETTER BA-->
            <Key
                latin:keySpec="&#x0C2C;"
                latin:keyLabelFlags="fontNormal" />

            <!--మ TELUGU LETTER MA-->
            <Key
                latin:keySpec="&#x0C2E;"
                latin:keyLabelFlags="fontNormal" />

            <!--య TELUGU LETTER YA-->
            <Key
                latin:keySpec="&#x0C2F;"
                latin:keyLabelFlags="fontNormal" />

            <!--చ TELUGU LETTER CA-->
            <Key
                latin:keySpec="&#x0C1A;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

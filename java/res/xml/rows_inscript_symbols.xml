<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/key_styles_currency" />
    <Row latin:keyLabelFlags="autoXScale" latin:keyWidth="7.692%p" >
        <include latin:keyboardLayout="@xml/rowkeys_inscript_symbols1" />
    </Row>
    <Row latin:keyLabelFlags="autoXScale" latin:keyWidth="7.692%p" >
        <include latin:keyboardLayout="@xml/rowkeys_inscript_symbols2" />
    </Row>
    <Row latin:keyLabelFlags="autoXScale" latin:keyWidth="7.692%p" >
        <include
            latin:keyboardLayout="@xml/rowkeys_inscript_symbols3"
            latin:keyXPos="3.846%p" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <Row latin:keyLabelFlags="autoXScale" latin:keyWidth="7.692%p" >
        <Key
            latin:keySpec=","
            latin:keyWidth="11.538%p"
            latin:visualInsetsRight="1%p" />
        <include latin:keyboardLayout="@xml/rowkeys_inscript_symbols4" />
        <Key
            latin:keySpec="."
            latin:moreKeys="&#x2026;"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <include latin:keyboardLayout="@xml/row_inscript_symbols5" />
</merge>

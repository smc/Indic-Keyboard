<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--A অ BENGALI LETTER A-->
            <Key
                latin:keySpec="&#x0985;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--S ষ BENGALI LETTER SSA-->
            <Key
                latin:keySpec="&#x09B7;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--D ঢ BENGALI LETTER DDHA-->
            <Key
                latin:keySpec="&#x09A2;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--F থ BENGALI LETTER THA-->
            <Key
                latin:keySpec="&#x09A5;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--G ঘ BENGALI LETTER GHA-->
            <Key
                latin:keySpec="&#x0998;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--H ঃ BENGALI SIGN VISARGA-->
            <Key
                latin:keySpec="&#x0983;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--J ঝ BENGALI LETTER JHA-->
            <Key
                latin:keySpec="&#x099D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--K খ BENGALI LETTER KHA-->
            <Key
                latin:keySpec="&#x0996;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--L ং BENGALI SIGN ANUSVARA-->
            <Key
                latin:keySpec="&#x0982;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--a া BENGALI VOWEL SIGN AA-->
            <Key
                latin:keySpec="&#x09BE;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--s স BENGALI LETTER SA-->
            <Key
                latin:keySpec="&#x09B8;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--d ড BENGALI LETTER DDA-->
            <Key
                latin:keySpec="&#x09A1;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--f ত BENGALI LETTER TA-->
            <Key
                latin:keySpec="&#x09A4;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--g গ BENGALI LETTER GA-->
            <Key
                latin:keySpec="&#x0997;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--h হ BENGALI LETTER HA-->
            <Key
                latin:keySpec="&#x09B9;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--j জ BENGALI LETTER JA-->
            <Key
                latin:keySpec="&#x099C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--k ক BENGALI LETTER KA-->
            <Key
                latin:keySpec="&#x0995;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--l ল BENGALI LETTER LA-->
            <Key
                latin:keySpec="&#x09B2;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

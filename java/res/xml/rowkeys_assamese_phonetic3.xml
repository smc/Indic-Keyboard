<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Z য BENGALI LETTER YA-->
            <Key
                latin:keySpec="&#x09AF;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--X ঢ় BENGALI LETTER RHA-->
            <Key
                latin:keySpec="&#x09DD;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--C ছ BENGALI LETTER CHA-->
            <Key
                latin:keySpec="&#x099B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--V ঋ BENGALI LETTER VOCALIC R-->
            <Key
                latin:keySpec="&#x098B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--B ভ BENGALI LETTER BHA-->
            <Key
                latin:keySpec="&#x09AD;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--N ণ BENGALI LETTER NNA-->
            <Key
                latin:keySpec="&#x09A3;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--M ঙ BENGALI LETTER NGA-->
            <Key
                latin:keySpec="&#x0999;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--z য় BENGALI LETTER YYA-->
            <Key
                latin:keySpec="&#x09DF;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--x শ BENGALI LETTER SHA-->
            <Key
                latin:keySpec="&#x09B6;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--c চ BENGALI LETTER CA-->
            <Key
                latin:keySpec="&#x099A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--v আ BENGALI LETTER AA-->
            <Key
                latin:keySpec="&#x0986;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--b ব BENGALI LETTER BA-->
            <Key
                latin:keySpec="&#x09AC;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--n ন BENGALI LETTER NA-->
            <Key
                latin:keySpec="&#x09A8;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--m ম BENGALI LETTER MA-->
            <Key
                latin:keySpec="&#x09AE;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

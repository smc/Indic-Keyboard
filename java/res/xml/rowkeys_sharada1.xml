<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />
            <!-- 𑇄 SHARADA OM -->
            <Key
                latin:keySpec="&#x111C4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆽 SHARADA VOWEL SIGN AI -->
            <Key
                latin:keySpec="&#x111BD;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆸 SHARADA VOWEL SIGN VOCALIC R -->
            <Key
                latin:keySpec="&#x111B8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆡 SHARADA LETTER THA -->
            <Key
                latin:keySpec="&#x111A1;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆚 SHARADA LETTER NYA -->
            <Key
                latin:keySpec="&#x1119A;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆷 SHARADA VOWEL SIGN UU -->
            <Key
                latin:keySpec="&#x111B7;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆵 SHARADA VOWEL SIGN II -->
            <Key
                latin:keySpec="&#x111B5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆿 SHARADA VOWEL SIGN AU -->
            <Key
                latin:keySpec="&#x111BF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆦 SHARADA LETTER PHA -->
            <Key
                latin:keySpec="&#x111A6;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <Key
                latin:keySpec="!icon/zwnj_key|&#x200C;"
                latin:moreKeys="!icon/zwj_key|&#x200D;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆮 SHARADA LETTER VA -->
            <Key
                latin:keySpec="&#x111AE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆼 SHARADA VOWEL SIGN E -->
            <Key
                latin:keySpec="&#x111BC;"
                latin:moreKeys="&#x1118D;,&#x1118E;"
                latin:keyHintLabel="&#x1118D;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆫 SHARADA LETTER RA -->
            <Key
                latin:keySpec="&#x111AB;"
                latin:moreKeys="&#x11189;,&#x1118A;,&#x111B9;"
                latin:keyHintLabel="&#x11189;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆠 SHARADA LETTER TA -->
            <Key
                latin:keySpec="&#x111A0;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆪 SHARADA LETTER YA -->
            <Key
                latin:keySpec="&#x111AA;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆶 SHARADA VOWEL SIGN U -->
            <Key
                latin:keySpec="&#x111B6;"
                latin:moreKeys="&#x11187;,&#x11188;"
                latin:keyHintLabel="&#x11187;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆴 SHARADA VOWEL SIGN I -->
            <Key
                latin:keySpec="&#x111B4;"
                latin:moreKeys="&#x11185;,&#x11186;"
                latin:keyHintLabel="&#x11185;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆾 SHARADA VOWEL SIGN O -->
            <Key
                latin:keySpec="&#x111BE;"
                latin:moreKeys="&#x1118F;,&#x11190;"
                latin:keyHintLabel="&#x1118F;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑆥 SHARADA LETTER PA -->
            <Key
                latin:keySpec="&#x111A5;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

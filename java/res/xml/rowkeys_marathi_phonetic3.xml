<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Z ँ DEVANAGARI SIGN CANDRABINDU-->
            <Key
                latin:keySpec="&#x0901;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--X क्ष DEVANAGARI LETTER KA DEVANAGARI SIGN VIRAMA DEVANAGARI LETTER SSA-->
            <Key
                latin:keySpec="&#x0915;&#x094D;&#x0937;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--C छ DEVANAGARI LETTER CHA-->
            <Key
                latin:keySpec="&#x091B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--V ऴ DEVANAGARI LETTER LLLA-->
            <Key
                latin:keySpec="&#x0934;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--B भ DEVANAGARI LETTER BHA-->
            <Key
                latin:keySpec="&#x092D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--N ण DEVANAGARI LETTER NNA-->
            <Key
                latin:keySpec="&#x0923;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--M ं DEVANAGARI SIGN ANUSVARA-->
            <Key
                latin:keySpec="&#x0902;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--? ऐ DEVANAGARI LETTER AI-->
            <Key
                latin:keySpec="&#x0910;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--z ङ DEVANAGARI LETTER NGA-->
            <Key
                latin:keySpec="&#x0919;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--x ष DEVANAGARI LETTER SSA-->
            <Key
                latin:keySpec="&#x0937;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--c च DEVANAGARI LETTER CA-->
            <Key
                latin:keySpec="&#x091A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--v व DEVANAGARI LETTER VA-->
            <Key
                latin:keySpec="&#x0935;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--b ब DEVANAGARI LETTER BA-->
            <Key
                latin:keySpec="&#x092C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--n न DEVANAGARI LETTER NA-->
            <Key
                latin:keySpec="&#x0928;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--m म DEVANAGARI LETTER MA-->
            <Key
                latin:keySpec="&#x092E;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--/ ए DEVANAGARI LETTER E-->
            <Key
                latin:keySpec="&#x090F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

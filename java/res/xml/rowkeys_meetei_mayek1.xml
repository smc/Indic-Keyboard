<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꯘ MEETEI MAYEK LETTER GHOU -->
            <Key
                latin:keySpec="&#xABD8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯋ MEETEI MAYEK LETTER WAI -->
            <Key
                latin:keySpec="&#xABCB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯢ MEETEI MAYEK LETTER I LONSUM -->
            <Key
                latin:keySpec="&#xABE2;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯔ MEETEI MAYEK LETTER RAI -->
            <Key
                latin:keySpec="&#xABD4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯠ MEETEI MAYEK LETTER TIL LONSUM -->
            <Key
                latin:keySpec="&#xABE0;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯦ MEETEI MAYEK VOWEL SIGN YENAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE6;|&#xABE6;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯨ MEETEI MAYEK VOWEL SIGN UNAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE8;|&#xABE8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯩ MEETEI MAYEK VOWEL SIGN CHEINAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE9;|&#xABE9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯧ MEETEI MAYEK VOWEL SIGN SOUNAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE7;|&#xABE7;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯞ MEETEI MAYEK LETTER PA LONSUM -->
            <Key
                latin:keySpec="&#xABDE;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- ꯈ MEETEI MAYEK LETTER KHOU -->
            <Key
                latin:keySpec="&#xABC8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯋ MEETEI MAYEK LETTER WAI -->
            <Key
                latin:keySpec="&#xABCB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯏ MEETEI MAYEK LETTER I -->
            <Key
                latin:keySpec="&#xABCF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯔ MEETEI MAYEK LETTER RAI -->
            <Key
                latin:keySpec="&#xABD4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯇ MEETEI MAYEK LETTER TIL -->
            <Key
                latin:keySpec="&#xABC7;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯌ MEETEI MAYEK LETTER YANG -->
            <Key
                latin:keySpec="&#xABCC;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯎ MEETEI MAYEK LETTER UN -->
            <Key
                latin:keySpec="&#xABCE;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯤ MEETEI MAYEK VOWEL SIGN INAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE4;|&#xABE4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯣ MEETEI MAYEK VOWEL SIGN ONAP -->
            <Key
                latin:keySpec="&#x25CC;&#xABE3;|&#xABE3;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯄ MEETEI MAYEK LETTER PA -->
            <Key
                latin:keySpec="&#xABC4;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- 𑢤 WARANG CITI CAPITAL LETTER YA -->
            <Key
                latin:keySpec="&#x118A4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢿 WARANG CITI CAPITAL LETTER VIYO -->
            <Key
                latin:keySpec="&#x118BF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢨 WARANG CITI CAPITAL LETTER E -->
            <Key
                latin:keySpec="&#x118A8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢼 WARANG CITI CAPITAL LETTER HAR -->
            <Key
                latin:keySpec="&#x118BC;"
                latin:moreKeys="&#x118BB;"
                latin:keyHintLabel="&#x118BB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢲 WARANG CITI CAPITAL LETTER TTE -->
            <Key
                latin:keySpec="&#x118B2;"
                latin:moreKeys="&#x118B5;"
                latin:keyHintLabel="&#x118B5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢥 WARANG CITI CAPITAL LETTER YO -->
            <Key
                latin:keySpec="&#x118A5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢧 WARANG CITI CAPITAL LETTER UU -->
            <Key
                latin:keySpec="&#x118A7;"
                latin:moreKeys="&#x118A3;"
                latin:keyHintLabel="&#x118A3;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢦 WARANG CITI CAPITAL LETTER II -->
            <Key
                latin:keySpec="&#x118A6;"
                latin:moreKeys="&#x118A2;"
                latin:keyHintLabel="&#x118A2;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢩 WARANG CITI CAPITAL LETTER O -->
            <Key
                latin:keySpec="&#x118A9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑢸 WARANG CITI CAPITAL LETTER PU -->
            <Key
                latin:keySpec="&#x118B8;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- 𑣄 WARANG CITI SMALL LETTER YA -->
            <Key
                latin:keySpec="&#x118C4;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣟 WARANG CITI SMALL LETTER VIYO -->
            <Key
                latin:keySpec="&#x118DF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣈 WARANG CITI SMALL LETTER E -->
            <Key
                latin:keySpec="&#x118C8;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣜 WARANG CITI SMALL LETTER HAR -->
            <Key
                latin:keySpec="&#x118DC;"
                latin:moreKeys="&#x118DB;"
                latin:keyHintLabel="&#x118DB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣒 WARANG CITI SMALL LETTER TTE -->
            <Key
                latin:keySpec="&#x118D2;"
                latin:moreKeys="&#x118D5;"
                latin:keyHintLabel="&#x118D5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣅 WARANG CITI SMALL LETTER YO -->
            <Key
                latin:keySpec="&#x118C5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣇 WARANG CITI SMALL LETTER UU -->
            <Key
                latin:keySpec="&#x118C7;"
                latin:moreKeys="&#x118C3;"
                latin:keyHintLabel="&#x118C3;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣆 WARANG CITI SMALL LETTER II -->
            <Key
                latin:keySpec="&#x118C6;"
                latin:moreKeys="&#x118C2;"
                latin:keyHintLabel="&#x118C2;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣉 WARANG CITI SMALL LETTER O -->
            <Key
                latin:keySpec="&#x118C9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- 𑣘 WARANG CITI SMALL LETTER PU -->
            <Key
                latin:keySpec="&#x118D8;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

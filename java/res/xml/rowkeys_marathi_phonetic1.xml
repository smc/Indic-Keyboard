<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Q औ DEVANAGARI LETTER AU-->
            <Key
                latin:keySpec="&#x0914;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--W ठ DEVANAGARI LETTER TTHA-->
            <Key
                latin:keySpec="&#x0920;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--E ै DEVANAGARI VOWEL SIGN AI-->
            <Key
                latin:keySpec="&#x0948;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--R ृ DEVANAGARI VOWEL SIGN VOCALIC R-->
            <Key
                latin:keySpec="&#x0943;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--T थ DEVANAGARI LETTER THA-->
            <Key
                latin:keySpec="&#x0925;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--Y य़ DEVANAGARI LETTER YYA-->
            <Key
                latin:keySpec="&#x095F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--U ू DEVANAGARI VOWEL SIGN UU-->
            <Key
                latin:keySpec="&#x0942;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--I ी DEVANAGARI VOWEL SIGN II-->
            <Key
                latin:keySpec="&#x0940;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--O ौ DEVANAGARI VOWEL SIGN AU-->
            <Key
                latin:keySpec="&#x094C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--P फ DEVANAGARI LETTER PHA-->
            <Key
                latin:keySpec="&#x092B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--{ ढ DEVANAGARI LETTER DDHA-->
            <Key
                latin:keySpec="&#x0922;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--} ऱ DEVANAGARI LETTER RRA-->
            <Key
                latin:keySpec="&#x0931;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--q ओ DEVANAGARI LETTER O-->
            <Key
                latin:keySpec="&#x0913;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--w ट DEVANAGARI LETTER TTA-->
            <Key
                latin:keySpec="&#x091F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--e े DEVANAGARI VOWEL SIGN E-->
            <Key
                latin:keySpec="&#x0947;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--r र DEVANAGARI LETTER RA-->
            <Key
                latin:keySpec="&#x0930;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--t त DEVANAGARI LETTER TA-->
            <Key
                latin:keySpec="&#x0924;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--y य DEVANAGARI LETTER YA-->
            <Key
                latin:keySpec="&#x092F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--u ु DEVANAGARI VOWEL SIGN U-->
            <Key
                latin:keySpec="&#x0941;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--i ि DEVANAGARI VOWEL SIGN I-->
            <Key
                latin:keySpec="&#x093F;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--o ो DEVANAGARI VOWEL SIGN O-->
            <Key
                latin:keySpec="&#x094B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--p प DEVANAGARI LETTER PA-->
            <Key
                latin:keySpec="&#x092A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--[ ड DEVANAGARI LETTER DDA-->
            <Key
                latin:keySpec="&#x0921;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--] ऋ DEVANAGARI LETTER VOCALIC R-->
            <Key
                latin:keySpec="&#x090B;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--A ଆ ORIYA LETTER AA-->
            <Key
                latin:keySpec="&#x0B06;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--S ଶ ORIYA LETTER SHA-->
            <Key
                latin:keySpec="&#x0B36;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--D ଧ ORIYA LETTER DHA-->
            <Key
                latin:keySpec="&#x0B27;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--F ଅ ORIYA LETTER A-->
            <Key
                latin:keySpec="&#x0B05;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--G ଘ ORIYA LETTER GHA-->
            <Key
                latin:keySpec="&#x0B18;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--H ଃ ORIYA SIGN VISARGA-->
            <Key
                latin:keySpec="&#x0B03;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--J ଝ ORIYA LETTER JHA-->
            <Key
                latin:keySpec="&#x0B1D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--K ଖ ORIYA LETTER KHA-->
            <Key
                latin:keySpec="&#x0B16;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--L ଳ ORIYA LETTER LLA-->
            <Key
                latin:keySpec="&#x0B33;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--: ଈ ORIYA LETTER II-->
            <Key
                latin:keySpec="&#x0B08;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--" ଊ ORIYA LETTER UU-->
            <Key
                latin:keySpec="&#x0B0A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--a ା ORIYA VOWEL SIGN AA-->
            <Key
                latin:keySpec="&#x0B3E;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--s ସ ORIYA LETTER SA-->
            <Key
                latin:keySpec="&#x0B38;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--d ଦ ORIYA LETTER DA-->
            <Key
                latin:keySpec="&#x0B26;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--f ୍ ORIYA SIGN VIRAMA-->
            <Key
                latin:keySpec="&#x0B4D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--g ଗ ORIYA LETTER GA-->
            <Key
                latin:keySpec="&#x0B17;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--h ହ ORIYA LETTER HA-->
            <Key
                latin:keySpec="&#x0B39;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--j ଜ ORIYA LETTER JA-->
            <Key
                latin:keySpec="&#x0B1C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--k କ ORIYA LETTER KA-->
            <Key
                latin:keySpec="&#x0B15;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--l ଲ ORIYA LETTER LA-->
            <Key
                latin:keySpec="&#x0B32;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--; ଇ ORIYA LETTER I-->
            <Key
                latin:keySpec="&#x0B07;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--' ଉ ORIYA LETTER U-->
            <Key
                latin:keySpec="&#x0B09;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

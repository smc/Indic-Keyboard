<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--A आ DEVANAGARI LETTER AA-->
            <Key
                latin:keySpec="&#x0906;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--S श DEVANAGARI LETTER SHA-->
            <Key
                latin:keySpec="&#x0936;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--D ध DEVANAGARI LETTER DHA-->
            <Key
                latin:keySpec="&#x0927;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--F अ DEVANAGARI LETTER A-->
            <Key
                latin:keySpec="&#x0905;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--G घ DEVANAGARI LETTER GHA-->
            <Key
                latin:keySpec="&#x0918;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--H ः DEVANAGARI SIGN VISARGA-->
            <Key
                latin:keySpec="&#x0903;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--J झ DEVANAGARI LETTER JHA-->
            <Key
                latin:keySpec="&#x091D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--K ख DEVANAGARI LETTER KHA-->
            <Key
                latin:keySpec="&#x0916;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--L ळ DEVANAGARI LETTER LLA-->
            <Key
                latin:keySpec="&#x0933;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--: ई DEVANAGARI LETTER II-->
            <Key
                latin:keySpec="&#x0908;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--" ऊ DEVANAGARI LETTER UU-->
            <Key
                latin:keySpec="&#x090A;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </case>
        <default>
            <!--a ा DEVANAGARI VOWEL SIGN AA-->
            <Key
                latin:keySpec="&#x093E;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--s स DEVANAGARI LETTER SA-->
            <Key
                latin:keySpec="&#x0938;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--d द DEVANAGARI LETTER DA-->
            <Key
                latin:keySpec="&#x0926;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--f ् DEVANAGARI SIGN VIRAMA-->
            <Key
                latin:keySpec="&#x094D;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--g ग DEVANAGARI LETTER GA-->
            <Key
                latin:keySpec="&#x0917;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--h ह DEVANAGARI LETTER HA-->
            <Key
                latin:keySpec="&#x0939;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--j ज DEVANAGARI LETTER JA-->
            <Key
                latin:keySpec="&#x091C;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--k क DEVANAGARI LETTER KA-->
            <Key
                latin:keySpec="&#x0915;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--l ल DEVANAGARI LETTER LA-->
            <Key
                latin:keySpec="&#x0932;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--; इ DEVANAGARI LETTER I-->
            <Key
                latin:keySpec="&#x0907;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

            <!--' उ DEVANAGARI LETTER U-->
            <Key
                latin:keySpec="&#x0909;"
                latin:keyLabelFlags="fontNormal|followKeyLetterRatio" />

        </default>
    </switch>
</merge>

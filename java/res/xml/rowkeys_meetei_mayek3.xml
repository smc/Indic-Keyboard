<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꯡ MEETEI MAYEK LETTER NGOU LONSUM -->
            <Key
                latin:keySpec="&#xABE1;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯙ MEETEI MAYEK LETTER DHOU -->
            <Key
                latin:keySpec="&#xABD9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯫ MEETEI MAYEK CHEIKHEI -->
            <Key
                latin:keySpec="&#xABEB;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯭ MEETEI MAYEK APUN IYEK -->
            <Key
                latin:keySpec="&#x25CC;&#xABED;|&#xABED;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯬ MEETEI MAYEK LUM IYEK -->
            <Key
                latin:keySpec="&#x25CC;&#xABEC;|&#xABEC;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯟ MEETEI MAYEK LETTER NA LONSUM -->
            <Key
                latin:keySpec="&#xABDF;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯝ MEETEI MAYEK LETTER MIT LONSUM -->
            <Key
                latin:keySpec="&#xABDD;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- ꯉ MEETEI MAYEK LETTER NGOU -->
            <Key
                latin:keySpec="&#xABC9;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯊ MEETEI MAYEK LETTER THOU -->
            <Key
                latin:keySpec="&#xABCA;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯆ MEETEI MAYEK LETTER CHIL -->
            <Key
                latin:keySpec="&#xABC6;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯚ MEETEI MAYEK LETTER BHAM -->
            <Key
                latin:keySpec="&#xABDA;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯕ MEETEI MAYEK LETTER BA -->
            <Key
                latin:keySpec="&#xABD5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯅ MEETEI MAYEK LETTER NA -->
            <Key
                latin:keySpec="&#xABC5;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꯃ MEETEI MAYEK LETTER MIT -->
            <Key
                latin:keySpec="&#xABC3;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

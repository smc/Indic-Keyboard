<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--ళ TELUGU LETTER LLA-->
            <Key
                latin:keySpec="&#x0C33;"
                latin:keyLabelFlags="fontNormal" />

            <!--థ TELUGU LETTER THA-->
            <Key
                latin:keySpec="&#x0C25;"
                latin:keyLabelFlags="fontNormal" />

            <!--ధ TELUGU LETTER DHA-->
            <Key
                latin:keySpec="&#x0C27;"
                latin:keyLabelFlags="fontNormal" />

            <!--శ TELUGU LETTER SHA-->
            <Key
                latin:keySpec="&#x0C36;"
                latin:moreKeys="&#x0C0C;"
                latin:keyHintLabel="&#x0C0C;"
                latin:keyLabelFlags="fontNormal" />

            <!--: COLON-->
            <Key
                latin:keySpec="&#x003A;"
                latin:keyLabelFlags="fontNormal" />

            <!--్ TELUGU SIGN VIRAMA-->
            <Key
                latin:keySpec="&#x0C4D;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఖ TELUGU LETTER KHA-->
            <Key
                latin:keySpec="&#x0C16;"
                latin:keyLabelFlags="fontNormal" />

            <!--ఱ TELUGU LETTER RRA-->
            <Key
                latin:keySpec="&#x0C31;"
                latin:keyLabelFlags="fontNormal" />

            <!--ణ TELUGU LETTER NNA-->
            <Key
                latin:keySpec="&#x0C23;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--ల TELUGU LETTER LA-->
            <Key
                latin:keySpec="&#x0C32;"
                latin:keyLabelFlags="fontNormal" />

            <!--త TELUGU LETTER TA-->
            <Key
                latin:keySpec="&#x0C24;"
                latin:keyLabelFlags="fontNormal" />

            <!--ద TELUGU LETTER DA-->
            <Key
                latin:keySpec="&#x0C26;"
                latin:keyLabelFlags="fontNormal" />

            <!--వ TELUGU LETTER VA-->
            <Key
                latin:keySpec="&#x0C35;"
                latin:moreKeys="&#x0C62;"
                latin:keyHintLabel="&#x0C62;"
                latin:keyLabelFlags="fontNormal" />

            <!--ం TELUGU SIGN ANUSVARA-->
            <Key
                latin:keySpec="&#x0C02;"
                latin:keyLabelFlags="fontNormal" />

            <!--్ TELUGU SIGN VIRAMA-->
            <Key
                latin:keySpec="&#x0C4D;"
                latin:keyLabelFlags="fontNormal" />

            <!--క TELUGU LETTER KA-->
            <Key
                latin:keySpec="&#x0C15;"
                latin:keyLabelFlags="fontNormal" />

            <!--ర TELUGU LETTER RA-->
            <Key
                latin:keySpec="&#x0C30;"
                latin:keyLabelFlags="fontNormal" />

            <!--న TELUGU LETTER NA-->
            <Key
                latin:keySpec="&#x0C28;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

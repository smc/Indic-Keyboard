<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- 𐴜 HANIFI ROHINGYA LETTER VA -->
            <Key
                latin:keySpec="&#x10D1C;" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- 𐴚 HANIFI ROHINGYA LETTER NGA -->
            <Key
                latin:keySpec="&#x10D1A;" />

            <!-- 𐴛 HANIFI ROHINGYA LETTER NYA -->
            <Key
                latin:keySpec="&#x10D1B;" />

        </case>
        <default>
            <!-- 𐴎 HANIFI ROHINGYA LETTER ZA -->
            <Key
                latin:keySpec="&#x10D0E;" />

            <!-- 𐴈 HANIFI ROHINGYA LETTER KHA -->
            <Key
                latin:keySpec="&#x10D08;" />

            <!-- 𐴆 HANIFI ROHINGYA LETTER CA -->
            <Key
                latin:keySpec="&#x10D06;" />

            <!-- 𐴀 HANIFI ROHINGYA LETTER A -->
            <Key
                latin:keySpec="&#x10D00;" />

            <!-- 𐴁 HANIFI ROHINGYA LETTER BA -->
            <Key
                latin:keySpec="&#x10D01;" />

            <!-- 𐴕 HANIFI ROHINGYA LETTER NA -->
            <Key
                latin:keySpec="&#x10D15;"
                latin:moreKeys="&#x10D1B;,&#x10D1A;"
                latin:keyHintLabel="&#x10D1B;" />

            <!-- 𐴔 HANIFI ROHINGYA LETTER MA -->
            <Key
                latin:keySpec="&#x10D14;" />

        </default>
    </switch>
</merge>

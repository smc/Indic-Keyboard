<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
 >
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
            >
            <!--Q ਔ GURMUKHI LETTER AU-->
            <Key
                latin:keySpec="&#x0A14;"
                latin:keyLabelFlags="fontNormal" />

            <!--W ਐ GURMUKHI LETTER AI-->
            <Key
                latin:keySpec="&#x0A10;"
                latin:keyLabelFlags="fontNormal" />

            <!--E ਆ GURMUKHI LETTER AA-->
            <Key
                latin:keySpec="&#x0A06;"
                latin:keyLabelFlags="fontNormal" />

            <!--R ਈ GURMUKHI LETTER II-->
            <Key
                latin:keySpec="&#x0A08;"
                latin:keyLabelFlags="fontNormal" />

            <!--T ਊ GURMUKHI LETTER UU-->
            <Key
                latin:keySpec="&#x0A0A;"
                latin:keyLabelFlags="fontNormal" />

            <!--Y ੜ GURMUKHI LETTER RRA-->
            <Key
                latin:keySpec="&#x0A5C;"
                latin:keyLabelFlags="fontNormal" />

            <!--U ਧ GURMUKHI LETTER DHA-->
            <Key
                latin:keySpec="&#x0A27;"
                latin:keyLabelFlags="fontNormal" />

            <!--I ਘ GURMUKHI LETTER GHA-->
            <Key
                latin:keySpec="&#x0A18;"
                latin:moreKeys="&#x0A19;"
                latin:keyHintLabel="&#x0A19;"
                latin:keyLabelFlags="fontNormal" />

            <!--O ਟ GURMUKHI LETTER TTA-->
            <Key
                latin:keySpec="&#x0A1F;"
                latin:moreKeys="&#x0A21;,&#x0A22;"
                latin:keyHintLabel="&#x0A21;"
                latin:keyLabelFlags="fontNormal" />

            <!--P ਫ GURMUKHI LETTER PHA-->
            <Key
                latin:keySpec="&#x0A2B;"
                latin:moreKeys="&#x0A5E;"
                latin:keyHintLabel="&#x0A5E;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!--q ੌ GURMUKHI VOWEL SIGN AU-->
            <Key
                latin:keySpec="&#x0A4C;"
                latin:keyLabelFlags="fontNormal" />

            <!--w ੈ GURMUKHI VOWEL SIGN AI-->
            <Key
                latin:keySpec="&#x0A48;"
                latin:keyLabelFlags="fontNormal" />

            <!--e ਾ GURMUKHI VOWEL SIGN AA-->
            <Key
                latin:keySpec="&#x0A3E;"
                latin:keyLabelFlags="fontNormal" />

            <!--r ੀ GURMUKHI VOWEL SIGN II-->
            <Key
                latin:keySpec="&#x0A40;"
                latin:keyLabelFlags="fontNormal" />

            <!--t ੂ GURMUKHI VOWEL SIGN UU-->
            <Key
                latin:keySpec="&#x0A42;"
                latin:keyLabelFlags="fontNormal" />

            <!--y ਰ GURMUKHI LETTER RA-->
            <Key
                latin:keySpec="&#x0A30;"
                latin:moreKeys="&#x0A4D;&#x0A30;"
                latin:keyHintLabel="&#x0A4D;&#x0A30;"
                latin:keyLabelFlags="fontNormal" />

            <!--u ਦ GURMUKHI LETTER DA-->
            <Key
                latin:keySpec="&#x0A26;"
                latin:keyLabelFlags="fontNormal" />

            <!--i ਗ GURMUKHI LETTER GA-->
            <Key
                latin:keySpec="&#x0A17;"
                latin:moreKeys="&#x0A5A;"
                latin:keyHintLabel="&#x0A5A;"
                latin:keyLabelFlags="fontNormal" />

            <!--o ਤ GURMUKHI LETTER TA-->
            <Key
                latin:keySpec="&#x0A24;"
                latin:keyLabelFlags="fontNormal" />

            <!--p ਪ GURMUKHI LETTER PA-->
            <Key
                latin:keySpec="&#x0A2A;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>

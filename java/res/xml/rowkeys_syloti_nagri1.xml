<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <!-- ꠬ SYLOTI NAGRI SIGN ALTERNATE HASANTA -->
            <Key
                latin:keySpec="&#x25CC;&#xA82C;|&#xA82C;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠄ SYLOTI NAGRI LETTER E -->
            <Key
                latin:keySpec="&#xA804;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠠ SYLOTI NAGRI LETTER RRO -->
            <Key
                latin:keySpec="&#xA820;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠕ SYLOTI NAGRI LETTER THO -->
            <Key
                latin:keySpec="&#xA815;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/zwnj_key|&#x200C;" />

            <!-- ꠃ SYLOTI NAGRI LETTER U -->
            <Key
                latin:keySpec="&#xA803;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠁ SYLOTI NAGRI LETTER I -->
            <Key
                latin:keySpec="&#xA801;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠅ SYLOTI NAGRI LETTER O -->
            <Key
                latin:keySpec="&#xA805;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠚ SYLOTI NAGRI LETTER PHO -->
            <Key
                latin:keySpec="&#xA81A;"
                latin:keyLabelFlags="fontNormal" />

        </case>
        <default>
            <!-- ꠆ SYLOTI NAGRI SIGN HASANTA -->
            <Key
                latin:keySpec="&#x25CC;&#xA806;|&#xA806;"
                latin:moreKeys="&#x25CC;&#xA82C;|&#xA82C;"
                latin:keyLabelFlags="fontNormal" />

            <Key latin:keySpec="!icon/undefined|!code/key_unspecified" />

            <!-- ꠦ SYLOTI NAGRI VOWEL SIGN E -->
            <Key
                latin:keySpec="&#x25CC;&#xA826;|&#xA826;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠞ SYLOTI NAGRI LETTER RO -->
            <Key
                latin:keySpec="&#xA81E;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠔ SYLOTI NAGRI LETTER TO -->
            <Key
                latin:keySpec="&#xA814;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠂ SYLOTI NAGRI SIGN DVISVARA -->
            <Key
                latin:keySpec="&#x25CC;&#xA802;|&#xA802;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠥ SYLOTI NAGRI VOWEL SIGN U -->
            <Key
                latin:keySpec="&#x25CC;&#xA825;|&#xA825;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠤ SYLOTI NAGRI VOWEL SIGN I -->
            <Key
                latin:keySpec="&#x25CC;&#xA824;|&#xA824;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠧ SYLOTI NAGRI VOWEL SIGN OO -->
            <Key
                latin:keySpec="&#x25CC;&#xA827;|&#xA827;"
                latin:keyLabelFlags="fontNormal" />

            <!-- ꠙ SYLOTI NAGRI LETTER PO -->
            <Key
                latin:keySpec="&#xA819;"
                latin:keyLabelFlags="fontNormal" />

        </default>
    </switch>
</merge>
